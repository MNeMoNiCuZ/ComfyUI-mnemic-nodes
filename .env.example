# ⚡ MNeMiC Nodes: secrets and private addresses
#
# Copy this file to ".env" in the same folder (it is created for you on first
# run) and fill in only what you use. Leave the rest empty.
#
# .env is git-ignored and read only by the ComfyUI backend. Nothing in it is
# ever written into a workflow, an image's metadata, or sent to the browser,
# so sharing workflows and images is safe. Edits apply on the next run; no
# restart needed. Variables already set in your system environment win.

# --- Cloud APIs --------------------------------------------------------------
# console.groq.com (Groq nodes + Universal LLM)
GROQ_API_KEY=
# platform.openai.com/api-keys
OPENAI_API_KEY=
# console.anthropic.com
ANTHROPIC_API_KEY=
# aistudio.google.com/apikey
GEMINI_API_KEY=
# console.x.ai
XAI_API_KEY=
# openrouter.ai/keys
OPENROUTER_API_KEY=
# console.mistral.ai
MISTRAL_API_KEY=
# platform.deepseek.com
DEEPSEEK_API_KEY=

# --- Local and network servers -----------------------------------------------
# Ollama on this PC. Only needed if it is not on the default port.
# default http://127.0.0.1:11434
OLLAMA_LOCAL_URL=

# Ollama on another machine on your network, e.g. http://192.168.1.50:11434
OLLAMA_NETWORK_URL=
# only if you put Ollama behind an auth proxy
OLLAMA_NETWORK_API_KEY=

# LM Studio on this PC. Only needed if it is not on the default port.
# default http://127.0.0.1:1234/v1
LMSTUDIO_URL=

# Any OpenAI-compatible server (llama.cpp, vLLM, KoboldCpp, LocalAI…),
# usually ending in /v1, e.g. http://192.168.1.60:8080/v1
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- Your own endpoints ------------------------------------------------------
# Endpoints you add in nodes/llm/UserEndpoints.json can reference any variable
# you define here as ${MY_VAR} or ${MY_VAR:-fallback}.
